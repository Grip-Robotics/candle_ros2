# Continuous impedance close. Response acknowledges startup, not contact/completion.

uint16[] device_ids
bool pre_close_enabled     # Deprecated, ignored: every close uses bounded impedance from the start
float32 pre_close_gap_mm   # Deprecated, ignored
float32 pre_close_offset_mm # Deprecated, ignored
float32 fast_speed         # Deprecated, ignored
float32 slow_speed         # Target ramp: [0, 1] -> [0.4, 6.0] rad/s, capped by gripper_velocity_limit_rad_s
---
bool[] success
